DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.goobuss\.com$ [NC]
  RewriteRule ^ https://goobuss.com%{REQUEST_URI} [R=301,L]

  # Remove index.html ou index.php da raiz.
  RewriteCond %{THE_REQUEST} \s/+index\.(?:html|php)[\s?] [NC]
  RewriteRule ^index\.(?:html|php)$ / [R=301,L,NE]

  # Remove index.html ou index.php de um caminho antigo sem perder a rota.
  RewriteCond %{THE_REQUEST} \s/+(.+)/index\.(?:html|php)[\s?] [NC]
  RewriteRule ^(.+)/index\.(?:html|php)$ /$1 [R=301,L,NE]

  # Remove extensões antigas das URLs públicas.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html|php)[\s?] [NC]
  RewriteRule ^(.+)\.(?:html|php)$ /$1 [R=301,L,NE]

  # A URL canônica não termina com barra, exceto a raiz.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s] [NC]
  RewriteRule ^(.+?)/+$ /$1 [R=301,L,NE]

  # Arquivos reais, inclusive imagens, fontes e endpoint de formulário.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Única entrada do frontend.
  RewriteRule ^$ /index.html [L]
  RewriteRule ^(empresa|servicos|frota|orcamento|contato|politica-de-privacidade)$ /index.html [L,NC]
  RewriteRule ^servicos/(aluguel-de-onibus|fretamento-corporativo|turismo-excursoes|transfers|eventos|escolas-formaturas|romarias|bandas-producoes)$ /index.html [L,NC]

  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#^/(empresa|servicos|frota|orcamento|contato|politica-de-privacidade)(/.*)?$# || %{REQUEST_URI} =~ m#\.(html|php)$#"
  Header always set Pragma "no-cache" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#^/(empresa|servicos|frota|orcamento|contato|politica-de-privacidade)(/.*)?$# || %{REQUEST_URI} =~ m#\.(html|php)$#"
  Header always set Expires "0" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#^/(empresa|servicos|frota|orcamento|contato|politica-de-privacidade)(/.*)?$# || %{REQUEST_URI} =~ m#\.(html|php)$#"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/(app|pages|cinematic|img|brand|video)#"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
