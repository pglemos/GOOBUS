DirectoryIndex index.php index.html
Options -Indexes
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.goobuss\.com$ [NC]
  RewriteRule ^ https://goobuss.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L,NE]

  RewriteRule ^(?:docs|tests|scripts|playwright-report|test-results)(?:/|$) - [F,L,NC]
  RewriteRule ^api/ - [L,NC]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # GOOBUS_FRONT_CONTROLLER_V4 — executa antes de qualquer diretório físico legado.
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(empresa|servicos|frota|orcamento|contato|politica-de-privacidade|servicos/(?:aluguel-de-onibus|fretamento-corporativo|turismo-excursoes|romarias|eventos|escolas-formaturas|bandas-producoes|transfers))$ /$1/ [R=301,L,NE]

  RewriteRule ^(?:$|empresa/?$|servicos/?$|frota/?$|orcamento/?$|contato/?$|politica-de-privacidade/?$|servicos/(?:aluguel-de-onibus|fretamento-corporativo|turismo-excursoes|romarias|eventos|escolas-formaturas|bandas-producoes|transfers)/?$) index.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#\.(html|php)$# || %{REQUEST_URI} =~ m#^/(empresa|servicos|frota|orcamento|contato|politica-de-privacidade)#"
  Header always set Pragma "no-cache" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#\.(html|php)$#"
  Header always set Expires "0" "expr=%{REQUEST_URI} == '/' || %{REQUEST_URI} =~ m#\.(html|php)$#"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/(cinematic|img|brand|video)#"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
