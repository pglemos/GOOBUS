DirectoryIndex index.html
DirectorySlash Off
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

RewriteEngine On

RewriteRule ^index\.html$ - [R=404,END]
RewriteRule ^(?:empresa|frota|servicos|orcamento|contato|politica-de-privacidade)(?:/|/index\.html)$ - [R=404,END]
RewriteRule ^servicos/(?:aluguel-de-onibus|fretamento-corporativo|turismo-excursoes|transfers|eventos|escolas-formaturas|romarias|bandas-producoes)(?:/|/index\.html)$ - [R=404,END]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]

RewriteRule ^$ index.html [END]
RewriteRule ^(?:empresa|frota|servicos|orcamento|contato|politica-de-privacidade)$ index.html [END]
RewriteRule ^servicos/(?:aluguel-de-onibus|fretamento-corporativo|turismo-excursoes|transfers|eventos|escolas-formaturas|romarias|bandas-producoes)$ index.html [END]

RewriteRule ^ - [R=404,END]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
